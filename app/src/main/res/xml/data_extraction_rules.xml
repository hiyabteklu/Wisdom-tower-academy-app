<?xml version="1.0" encoding="utf-8"?>
<!--
   Slice S3 (docs/SECURITY_PLAN_CONTENT_ACCESS.md). Android 12 and newer read this file instead of
   backup_rules.xml. Nothing is copied to cloud backup and nothing is copied when the owner or a student moves
   to a new phone: saved sign-in, downloaded notes and the offline vault stay on the phone they were made on.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
