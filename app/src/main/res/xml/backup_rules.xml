<?xml version="1.0" encoding="utf-8"?>
<!--
   Slice S3 (docs/SECURITY_PLAN_CONTENT_ACCESS.md). Nothing from this app is backed up (the manifest already says
   allowBackup="false"); these explicit excludes are a second lock for phones that read this file (Android 11 and
   older). Saved sign-in, downloaded notes and the offline vault must not leave the phone through a backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
